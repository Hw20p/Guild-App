<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hyeon.controller.GuildController" style="-fx-padding: 10;">

    <!-- 상단: 제목 및 통계 -->
    <top>
        <VBox spacing="10">
            <HBox alignment="CENTER" style="-fx-padding: 10;">
                <Label text="길드 멤버 관리 시스템" style="-fx-font-size: 24; -fx-font-weight: bold;" />
            </HBox>

            <!-- 통계 정보 -->
            <HBox spacing="20" alignment="CENTER" style="-fx-background-color: #f0f0f0; -fx-padding: 10; -fx-background-radius: 5;">
                <Label fx:id="totalMembersLabel" text="전체 멤버: 0명" style="-fx-font-weight: bold;" />
                <Separator orientation="VERTICAL" />
                <Label fx:id="subsCountLabel" text="부캐 보유자: 0명" />
                <Separator orientation="VERTICAL" />
                <Label fx:id="knightsCountLabel" text="기사 보유자: 0명" />
            </HBox>
        </VBox>
    </top>

    <!-- 중앙: 메인 콘텐츠 -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- 멤버 관리 탭 -->
            <Tab text="멤버 관리">
                <BorderPane>
                    <!-- 좌측: 입력 폼 -->
                    <left>
                        <VBox spacing="15" style="-fx-padding: 15; -fx-background-color: #fafafa; -fx-background-radius: 5;"
                              prefWidth="300" minWidth="300">
                            <Label text="멤버 등록/수정" style="-fx-font-size: 16; -fx-font-weight: bold;" />

                            <VBox spacing="5">
                                <Label text="이름 *" />
                                <TextField fx:id="nameField" promptText="길드원 이름을 입력하세요" />
                            </VBox>

                            <VBox spacing="5">
                                <Label text="부캐 목록" />
                                <TextField fx:id="subsField" promptText="부캐 이름들 (쉼표로 구분)" />
                                <Label text="예: 부캐1, 부캐2, 부캐3" style="-fx-font-size: 10; -fx-text-fill: gray;" />
                            </VBox>

                            <VBox spacing="5">
                                <Label text="기사 캐릭터 목록" />
                                <TextField fx:id="knightsField" promptText="기사 캐릭터 이름들 (쉼표로 구분)" />
                                <Label text="예: 기사1, 기사2, 기사3" style="-fx-font-size: 10; -fx-text-fill: gray;" />
                            </VBox>

                            <!-- 버튼 그룹 -->
                            <HBox spacing="10" alignment="CENTER">
                                <Button fx:id="addButton" text="등록" onAction="#handleAddMember"
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;" prefWidth="80" />
                                <Button fx:id="updateButton" text="수정" onAction="#handleUpdateMember"
                                        style="-fx-background-color: #2196F3; -fx-text-fill: white;" prefWidth="80" />
                                <Button fx:id="cancelButton" text="취소" onAction="#handleCancelEdit"
                                        style="-fx-background-color: #f44336; -fx-text-fill: white;" prefWidth="80" />
                            </HBox>

                            <Separator />

                            <!-- 유틸리티 버튼들 -->
                            <VBox spacing="10">
                                <Label text="데이터 관리" style="-fx-font-weight: bold;" />
                                <Button fx:id="exportButton" text="데이터 내보내기" onAction="#handleExportData"
                                        maxWidth="Infinity" />
                                <Button fx:id="sampleDataButton" text="샘플 데이터 추가" onAction="#handleAddSampleData"
                                        maxWidth="Infinity" />
                            </VBox>
                        </VBox>
                    </left>

                    <!-- 중앙: 멤버 목록 테이블 -->
                    <center>
                        <VBox spacing="10" style="-fx-padding: 15;">
                            <!-- 검색 바 -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="검색:" />
                                <TextField fx:id="searchField" promptText="이름, 부캐, 기사로 검색..."
                                           HBox.hgrow="ALWAYS" />
                                <Button fx:id="searchButton" text="검색" onAction="#handleSearch" />
                                <Button fx:id="clearSearchButton" text="전체보기" onAction="#handleClearSearch" />
                            </HBox>

                            <!-- 테이블 -->
                            <TableView fx:id="memberTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="nameColumn" text="이름" prefWidth="150" />
                                    <TableColumn fx:id="subsColumn" text="부캐" prefWidth="250" />
                                    <TableColumn fx:id="knightsColumn" text="기사" prefWidth="250" />
                                </columns>
                                <placeholder>
                                    <Label text="등록된 길드 멤버가 없습니다.\n좌측에서 새 멤버를 등록해보세요."
                                           style="-fx-text-alignment: center;" />
                                </placeholder>
                            </TableView>

                            <Label text="💡 팁: 테이블에서 더블클릭하면 수정, 우클릭하면 메뉴가 나타납니다."
                                   style="-fx-font-size: 10; -fx-text-fill: gray;" />
                        </VBox>
                    </center>
                </BorderPane>
            </Tab>

            <!-- 디스코드 메시지 분석 탭 -->
            <Tab text="디스코드 메시지 분석">
                <VBox spacing="15" style="-fx-padding: 15;">
                    <Label text="디스코드 메시지 분석" style="-fx-font-size: 16; -fx-font-weight: bold;" />

                    <!-- 입력 영역 -->
                    <VBox spacing="10">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="디스코드 메시지 입력:" />
                            <Button fx:id="parseDiscordButton" text="분석하기" onAction="#handleParseDiscord"
                                    style="-fx-background-color: #7289da; -fx-text-fill: white;" />
                        </HBox>

                        <TextArea fx:id="discordTextArea" prefRowCount="8"
                                  wrapText="true"
                                  style="-fx-font-family: monospace;" />
                    </VBox>

                    <!-- 결과 영역 -->
                    <VBox spacing="10" VBox.vgrow="ALWAYS">
                        <Label text="분석 결과:" style="-fx-font-weight: bold;" />
                        <TextArea fx:id="discordResultArea" prefRowCount="12"
                                  wrapText="true"
                                  editable="false"
                                  style="-fx-font-family: monospace; -fx-background-color: #f8f8f8;"
                                  VBox.vgrow="ALWAYS" />
                    </VBox>
                </VBox>
            </Tab>

            <!-- 도움말 탭 -->
            <Tab text="도움말">
                <ScrollPane fitToWidth="true">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <VBox spacing="10">
                            <Label text="🎮 길드 멤버 관리 시스템 사용법"
                                   style="-fx-font-size: 18; -fx-font-weight: bold;" />
                            <Separator />
                        </VBox>

                        <VBox spacing="15">
                            <VBox spacing="5">
                                <Label text="👥 멤버 관리" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                                <Label text="• 좌측 폼에서 이름, 부캐, 기사 캐릭터를 입력하고 '등록' 버튼을 클릭" wrapText="true" />
                                <Label text="• 테이블에서 멤버를 더블클릭하면 수정 모드로 전환" wrapText="true" />
                                <Label text="• 우클릭으로 컨텍스트 메뉴를 통해 수정/삭제 가능" wrapText="true" />
                                <Label text="• 여러 캐릭터는 쉼표(,)로 구분하여 입력" wrapText="true" />
                            </VBox>

                            <VBox spacing="5">
                                <Label text="🔍 검색 기능" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                                <Label text="• 이름, 부캐, 기사 캐릭터명으로 통합 검색 가능" wrapText="true" />
                                <Label text="• 부분 검색 지원 (예: '길'로 검색하면 '홍길동' 검색됨)" wrapText="true" />
                                <Label text="• '전체보기' 버튼으로 검색 초기화" wrapText="true" />
                            </VBox>

                            <VBox spacing="5">
                                <Label text="💬 디스코드 메시지 분석" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                                <Label text="• 디스코드에서 복사한 메시지를 붙여넣기" wrapText="true" />
                                <Label text="• 사용자별로 메시지를 자동 분류" wrapText="true" />
                                <Label text="• 메시지 통계 정보 제공 (총 사용자, 메시지 수 등)" wrapText="true" />
                                <Label text="• 지원 형식: '사용자명 - 오늘/어제/날짜 오전/오후 시:분'" wrapText="true" />
                            </VBox>

                            <VBox spacing="5">
                                <Label text="📊 데이터 관리" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                                <Label text="• '데이터 내보내기': 텍스트 파일로 멤버 목록 저장" wrapText="true" />
                                <Label text="• '샘플 데이터 추가': 테스트용 데이터 자동 생성" wrapText="true" />
                                <Label text="• 데이터는 자동으로 저장되어 프로그램 재실행 시 유지" wrapText="true" />
                            </VBox>

                            <VBox spacing="5">
                                <Label text="⌨️ 단축키" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                                <Label text="• Enter: 검색 실행" wrapText="true" />
                                <Label text="• 더블클릭: 멤버 수정" wrapText="true" />
                                <Label text="• 우클릭: 컨텍스트 메뉴" wrapText="true" />
                            </VBox>
                        </VBox>

                        <VBox spacing="10" style="-fx-background-color: #e3f2fd; -fx-padding: 15; -fx-background-radius: 5;">
                            <Label text="💡 활용 팁" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                            <Label text="• 길드 멤버의 모든 캐릭터를 체계적으로 관리할 수 있습니다" wrapText="true" />
                            <Label text="• 디스코드 채팅 내용을 쉽게 정리하고 분석할 수 있습니다" wrapText="true" />
                            <Label text="• 정기적으로 데이터를 내보내서 백업해두세요" wrapText="true" />
                            <Label text="• 검색 기능을 활용해 특정 멤버나 캐릭터를 빠르게 찾을 수 있습니다" wrapText="true" />
                        </VBox>
                    </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
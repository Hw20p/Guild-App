<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hyeon.controller.NavigationBarController"
      alignment="CENTER"
      spacing="20"
      style="-fx-padding: 15 30; -fx-background-color: rgba(0,0,0,0.3);">

    <Button text="🏠 홈"
            onAction="#goHome"
            style="-fx-font-size: 14px; -fx-padding: 10 20; -fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"/>

    <Button text="🔍 캐릭터 조회"
            onAction="#goSearch"
            style="-fx-font-size: 14px; -fx-padding: 10 20; -fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"/>

    <Button text="⚙️ 기타 기능"
            onAction="#goOther"
            style="-fx-font-size: 14px; -fx-padding: 10 20; -fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"/>

</HBox>